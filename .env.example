# Rccgmznl Web Client - Environment Variables
# Copy this file to .env and fill in the values

# ==========================
# API Configuration
# ==========================

VITE_BASE_URL=

# Use local proxy during development
# Allows cookies/session forwarding locally
VITE_USE_PROXY=false

# Enable debug logging
VITE_DEBUG=false

# Enable strict mode
VITE_ENABLE_STRICT_MODE=false
